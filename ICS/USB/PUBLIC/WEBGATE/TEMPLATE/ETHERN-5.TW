<HTML>
<!-- Vijeo Web Gate HTTP server -->
<HEAD>
	<TITLE>Vijeo Web Gate</TITLE>
	<link href="html/lib/css/main.css" type="text/css" rel="stylesheet" charset="ISO-8859-1">
	<link href="html/lib/css/static.css" type="text/css" rel="stylesheet" charset="ISO-8859-1">
	<script language="javascript" src="html/config.js" type="text/javascript"></script>
</HEAD>
<BODY>
<table width="100%" border="0">
<tr>
	<td class="title">&#x4E59;&#x592A;&#x7DB2;&#x8DEF; & TCP/IP&#x7D71;&#x8A08;&#x8CC7;&#x6599;</td>
</tr>
<tr>
<td>
<table class="statictable" width="400px" align="center" rules="all" frame="border">
	<tr><td colspan="3" class="tabletitle">TCP / IP &#x53C3;&#x6578;</td></tr>
	<tr><td class="staticlabel">IP &#x4F4D;&#x5740;</td><td class="staticvalue"><%= ethernet_ip_address1 %></td>
		<td class="staticvalue"><%= ethernet_ip_address2 %></td></tr>
	<tr><td class="staticlabel">&#x5B50;&#x7DB2;&#x8DEF;&#x906E;&#x7F69;</td><td class="staticvalue"><%= ethernet_subnet_mask1 %></td>
		<td class="staticvalue"><%= ethernet_subnet_mask2 %></td></tr>
	<tr><td class="staticlabel">&#x9810;&#x8A2D;&#x9598;&#x9053;</td><td class="staticvalue"><%= ethernet_default_gateway1 %></td>
		<td class="staticvalue"><%= ethernet_default_gateway2 %></td></tr>

	<tr><td colspan="3" class="tabletitle">&#x4E59;&#x592A;&#x7DB2;&#x8DEF;&#x53C3;&#x6578;</td></tr>
	<tr><td class="staticlabel">MAC&#x4F4D;&#x5740;</td><td class="staticvalue"><%= ethernet_mac_address1 %></td>
		<td class="staticvalue"><%= ethernet_mac_address2 %></td></tr>
	<tr><td class="staticlabel">&#x4E59;&#x592A;&#x7DB2;&#x8DEF;&#x6846;&#x67B6;&#x683C;&#x5F0F;</td>
		<td class="staticvalue"><%= ethernet_frame_format1 %></td><td class="staticvalue"><%= ethernet_frame_format2 %></td></tr>
</table>
</td>
</tr>
<tr>
	<td align="center">Copyright (C) <script language="javascript">InsertYears()</script>, Schneider Electric. &#x7248;&#x6B0A;&#x6240;&#x6709;&#x3002;</td>
</tr>
</table>
</BODY>
</HTML>
