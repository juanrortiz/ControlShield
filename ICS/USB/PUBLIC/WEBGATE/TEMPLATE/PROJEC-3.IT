<HTML>
<!-- Vijeo Web Gate HTTP server -->
<HEAD>
	<TITLE>Vijeo Web Gate</TITLE>
	<link href="html/lib/css/main.css" type="text/css" rel="stylesheet" charset="ISO-8859-1">
	<link href="html/lib/css/static.css" type="text/css" rel="stylesheet" charset="ISO-8859-1">
    <script language="javascript" src="html/config.js" type="text/javascript"></script>
</HEAD>
<BODY>
<table width="100%" border="0">
<tr>
	<td class="title">Statistiche del progetto</td>
</tr>
<tr>
<td>
<table class="statictable" width="300px" align="center" rules="all" frame="border">
	<tr><td colspan="2" class="tabletitle">Parametri del progetto</td></tr>
	<tr><td class="staticlabel">Tipo di pannello</td><td class="staticvalue"><%= project_panel_type %></td></tr>
	<tr><td class="staticlabel">Nome progetto</td><td class="staticvalue"><%= project_name %></td></tr>
	<tr><td class="staticlabel">Nome target</td><td class="staticvalue"><%= project_target_name %></td></tr>
	<tr><td class="staticlabel">Versione editor</td><td class="staticvalue"><%= project_editor_version %></td></tr>
	<tr><td class="staticlabel">Versione runtime</td><td class="staticvalue"><%= project_runtime_version %></td></tr>
</table>
</td>
</tr>
<tr>
	<td align="center">Copyright (C) <script language="javascript">InsertYears()</script>, Schneider-Electric Industries SAS. Tutti i diritti riservati.</td>
</tr>
</table>
</BODY>
</HTML>
